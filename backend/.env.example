# Comma-separated exact frontend origins. localhost and 127.0.0.1 are always allowed for development.
CORS_ORIGINS=https://example.vercel.app

# Optional coarse per-instance read limit. Use Cloud Armor/API Gateway for a distributed production limit.
RATE_LIMIT_PER_MINUTE=600

# Cloud Run injects PORT=8080. DATA_DIR defaults to ../public/data outside the container.
PORT=8080
DATA_DIR=

# P1 ContactOps state: local/test memory is isolated by X-Demo-Session-ID; production uses Firestore ADC.
CONTACT_OPS_STATE_BACKEND=memory
CONTACT_OPS_FIRESTORE_COLLECTION=synthetic_contact_ops_sessions
