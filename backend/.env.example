# Comma-separated exact frontend origins. localhost and 127.0.0.1 are always allowed for development.
CORS_ORIGINS=https://example.vercel.app

# Optional coarse per-instance read limit. Use Cloud Armor/API Gateway for a distributed production limit.
RATE_LIMIT_PER_MINUTE=600

# Cloud Run injects PORT=8080. DATA_DIR defaults to ../public/data outside the container.
PORT=8080
DATA_DIR=

# P1 ContactOps state: local/test memory is isolated by X-Demo-Session-ID; production uses Firestore ADC.
CONTACT_OPS_STATE_BACKEND=memory
CONTACT_OPS_FIRESTORE_COLLECTION=synthetic_contact_ops_sessions

# Mobile audio is staged here with random names and deleted after candidate generation.
VOICE_AUDIO_DIR=/tmp/contact-ops-audio

# Live Planner/Critic calls stay closed unless the gate and one text LLM transport are set.
ENABLE_LIVE_CONTACT_OPS_AI=0
# Preferred text transport. Use HTTPS outside localhost and a 32+ character bearer token.
CONTACT_OPS_CODEX_BRIDGE_URL=
CONTACT_OPS_CODEX_BRIDGE_TOKEN=
CONTACT_OPS_CODEX_BRIDGE_TOKEN_FILE=
CONTACT_OPS_CODEX_BRIDGE_TIMEOUT_MS=25000
# Still required for WAV/MP3/M4A transcription; text Planner/Critic uses the bridge above.
OPENAI_API_KEY=
OPENAI_VOICE_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_VOICE_TRANSCRIPTION_LANGUAGE=ko
