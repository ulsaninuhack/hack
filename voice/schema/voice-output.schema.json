{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "intent",
    "surveyor_id",
    "case_id",
    "transcript",
    "condition",
    "contact_result"
  ],
  "properties": {
    "intent": {
      "type": "string",
      "enum": ["condition", "contact_result", "other"]
    },
    "surveyor_id": {
      "type": "string",
      "pattern": "^연결단원 [0-9]{3}$"
    },
    "case_id": {
      "type": ["string", "null"],
      "pattern": "^CASE-[0-9]{4,8}$"
    },
    "transcript": {
      "type": "string",
      "minLength": 1
    },
    "condition": {
      "anyOf": [
        { "$ref": "#/$defs/condition" },
        { "type": "null" }
      ]
    },
    "contact_result": {
      "anyOf": [
        { "$ref": "#/$defs/contactResult" },
        { "type": "null" }
      ]
    }
  },
  "$defs": {
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "derived_constraints"],
      "properties": {
        "status": {
          "type": "string",
          "minLength": 1
        },
        "derived_constraints": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "avoid_stairs",
            "reduce_workload",
            "phone_only",
            "early_finish"
          ],
          "properties": {
            "avoid_stairs": { "type": "boolean" },
            "reduce_workload": { "type": "boolean" },
            "phone_only": { "type": "boolean" },
            "early_finish": { "type": "boolean" }
          }
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mail_piled",
        "odor_bugs",
        "trash_bottles",
        "tv_light_on",
        "no_outing",
        "no_contact",
        "meal_status",
        "hygiene"
      ],
      "properties": {
        "mail_piled": { "type": ["boolean", "null"] },
        "odor_bugs": { "type": ["boolean", "null"] },
        "trash_bottles": { "type": ["boolean", "null"] },
        "tv_light_on": { "type": ["boolean", "null"] },
        "no_outing": { "type": ["boolean", "null"] },
        "no_contact": { "type": ["boolean", "null"] },
        "meal_status": {
          "type": ["string", "null"],
          "enum": ["양호", "불량", "심각", null]
        },
        "hygiene": {
          "type": ["string", "null"],
          "enum": ["양호", "불량", "심각", null]
        }
      }
    },
    "contactResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reached",
        "observation",
        "free_text",
        "risk_signals",
        "risk_score",
        "visit_recommended",
        "evidence"
      ],
      "properties": {
        "reached": { "type": "boolean" },
        "observation": { "$ref": "#/$defs/observation" },
        "free_text": { "type": "string" },
        "risk_signals": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "risk_score": {
          "type": "integer",
          "minimum": 0
        },
        "visit_recommended": { "type": "boolean" },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
