{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "missing_fields",
    "contradictions",
    "low_confidence_fields",
    "warnings",
    "next_question"
  ],
  "properties": {
    "missing_fields": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "contradictions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "low_confidence_fields": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "next_question": {
      "type": ["string", "null"],
      "minLength": 2,
      "maxLength": 160,
      "pattern": "^[^\\r\\n?]{1,159}\\?$"
    }
  }
}
