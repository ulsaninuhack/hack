OPENAI_API_KEY=
# When set, text Planner/Critic calls use the authenticated Mac mini bridge.
# With both configured, network/timeout/gateway availability failures retry through OpenAI.
CONTACT_OPS_CODEX_BRIDGE_URL=
CONTACT_OPS_CODEX_BRIDGE_TOKEN=
CONTACT_OPS_CODEX_BRIDGE_TOKEN_FILE=
CONTACT_OPS_CODEX_BRIDGE_TIMEOUT_MS=25000
OPENAI_VOICE_TEXT_MODEL=gpt-4o-mini
OPENAI_VOICE_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_VOICE_TRANSCRIPTION_LANGUAGE=ko
ENABLE_LIVE_CONTACT_OPS_AI=0
OPENAI_CONTACT_OPS_CRITIC_MODEL=gpt-4o-mini
LIVE_WHISPER_AUDIO_PATH=
