CODEX_BRIDGE_TOKEN_FILE=/Users/your-account/Library/Application Support/IncheonCareCodexBridge/token
CODEX_BRIDGE_PORT=8765
CODEX_BRIDGE_MODEL=gpt-5.5
CODEX_BRIDGE_MODEL_TIMEOUT_MS=25000
CODEX_BRIDGE_REASONING_EFFORT=low
CODEX_BRIDGE_MAX_PENDING=4
CODEX_BRIDGE_RATE_LIMIT_PER_MINUTE=30
CODEX_BRIDGE_FUNNEL_PATH=/incheon-care-codex-bridge
CODEX_BIN=/opt/homebrew/bin/codex
