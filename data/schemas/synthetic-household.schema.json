{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://incheon-care-map.example/schemas/synthetic-household.schema.json",
  "title": "Incheon ContactOps synthetic contact-task dataset",
  "description": "Synthetic phone-first contact tasks for queue and rule-graph development, not people, inferred household risk, welfare eligibility, or benefit-recipient status.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_id",
    "synthetic",
    "scenario_reference_date",
    "seed",
    "guardrail",
    "spatial_contract",
    "households"
  ],
  "properties": {
    "schema_version": { "const": "2.0.0" },
    "dataset_id": { "const": "incheon-care-ops-synthetic-households-v2" },
    "synthetic": { "const": true },
    "scenario_reference_date": { "type": "string", "format": "date" },
    "seed": { "type": "integer" },
    "guardrail": { "type": "string", "minLength": 1 },
    "spatial_contract": { "$ref": "#/$defs/spatial_contract" },
    "households": {
      "type": "array",
      "minItems": 3240,
      "maxItems": 8100,
      "items": { "$ref": "#/$defs/household" }
    }
  },
  "$defs": {
    "time_window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "string", "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$" },
        "end": { "type": "string", "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$" }
      }
    },
    "spatial_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current_admin_reference_date",
        "geometry_reference_date",
        "current_admin_dong_count",
        "geometry_zone_count",
        "note"
      ],
      "properties": {
        "current_admin_reference_date": { "const": "2026-07-01" },
        "geometry_reference_date": { "const": "2025-06-30" },
        "current_admin_dong_count": { "const": 162 },
        "geometry_zone_count": { "const": 156 },
        "note": { "type": "string", "minLength": 1 }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "longitude",
        "latitude",
        "geometry_zone_id",
        "current_admin_dong_code_20260701",
        "current_admin_dong_name_20260701",
        "current_district_name_20260701",
        "geometry_resolution",
        "mapping_method",
        "spatial_basis",
        "reference_pnu",
        "road_address",
        "building_name",
        "main_use_names",
        "apartment_reference",
        "residential_building_reference",
        "address_source",
        "coordinate_source",
        "residential_classification_sources",
        "not_real_resident"
      ],
      "properties": {
        "longitude": { "type": "number", "minimum": 124, "maximum": 128 },
        "latitude": { "type": "number", "minimum": 36, "maximum": 39 },
        "geometry_zone_id": { "type": "string", "minLength": 1 },
        "current_admin_dong_code_20260701": { "type": "string", "pattern": "^\\d{10}$" },
        "current_admin_dong_name_20260701": { "type": "string", "minLength": 1 },
        "current_district_name_20260701": { "type": "string", "minLength": 1 },
        "geometry_resolution": {
          "enum": [
            "exact_2025_geometry_zone",
            "shared_pre_reform_2025_geometry_zone",
            "shared_parent_2025_geometry_zone",
            "shared_2025_geometry_zone"
          ]
        },
        "mapping_method": { "type": "string", "minLength": 1 },
        "spatial_basis": {
          "const": "official_residential_building_address_reference"
        },
        "reference_pnu": { "type": "string", "pattern": "^\\d{19}$" },
        "road_address": {
          "type": "string",
          "pattern": "^인천광역시 ",
          "minLength": 8
        },
        "building_name": { "type": "string" },
        "main_use_names": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "apartment_reference": { "type": "boolean" },
        "residential_building_reference": { "const": true },
        "address_source": { "const": "MOIS_JUSO_BUILDING_DB_202607" },
        "coordinate_source": {
          "enum": [
            "VWORLD_AL_D010_PNU_REPRESENTATIVE_POINT_20260809",
            "OPENSTREETMAP_NOMINATIM_RESIDENTIAL_FEATURE_20260813"
          ]
        },
        "residential_classification_sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "VWORLD_BUILDING_AGE_REGISTER_20260805",
              "MOIS_JUSO_BUILDING_DB_202607_COLLECTIVE_HOUSING_FLAG"
            ]
          }
        },
        "not_real_resident": { "const": true }
      }
    },
    "nullable_date": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      ]
    },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "next_contact_date",
        "preferred_contact_method",
        "contact_cadence_days",
        "last_contact_date",
        "last_contact_result",
        "consecutive_no_answer_count"
      ],
      "properties": {
        "next_contact_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "preferred_contact_method": { "enum": ["phone", "visit"] },
        "contact_cadence_days": { "enum": [3, 7, 14] },
        "last_contact_date": { "$ref": "#/$defs/nullable_date" },
        "last_contact_result": {
          "enum": [
            "not_attempted",
            "connected_ok",
            "connected_concern",
            "no_answer",
            "refused",
            "invalid_contact"
          ]
        },
        "consecutive_no_answer_count": { "type": "integer", "minimum": 0 }
      }
    },
    "management_entry": {
      "type": "object",
      "description": "Synthetic demo workflow entry. It records how a fictional contact-management task entered the workflow, contact permission, and an operational schedule-duplication check. It is not a welfare eligibility, recipient, or non-recipient determination.",
      "additionalProperties": false,
      "required": [
        "synthetic",
        "status",
        "intake_channel",
        "intake_recorded_date",
        "ongoing_contact_permission",
        "duplicate_service_check"
      ],
      "properties": {
        "synthetic": { "const": true },
        "status": { "const": "active_contact_management" },
        "intake_channel": {
          "enum": [
            "self_request",
            "family_request",
            "partner_agency_referral",
            "field_outreach"
          ]
        },
        "intake_recorded_date": {
          "type": "string",
          "format": "date"
        },
        "ongoing_contact_permission": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "recorded_date", "basis"],
          "properties": {
            "status": { "const": "recorded" },
            "recorded_date": { "type": "string", "format": "date" },
            "basis": { "const": "synthetic_demo_scenario" }
          }
        },
        "duplicate_service_check": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "checked_date", "scope", "interpretation"],
          "properties": {
            "status": { "const": "completed_no_overlapping_schedule" },
            "checked_date": { "type": "string", "format": "date" },
            "scope": { "const": "regular_wellbeing_contact_or_home_visit" },
            "interpretation": {
              "const": "workflow_duplicate_check_not_welfare_eligibility"
            }
          }
        }
      }
    },
    "visit_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preferred_visit_time_window",
        "preferred_worker_gender",
        "stairs_present",
        "service_duration_minutes",
        "requires_two_person_team",
        "requires_public_official_companion"
      ],
      "properties": {
        "preferred_visit_time_window": { "$ref": "#/$defs/time_window" },
        "preferred_worker_gender": { "enum": ["any", "female", "male"] },
        "stairs_present": { "type": "boolean" },
        "service_duration_minutes": { "enum": [20, 30, 40, 60] },
        "requires_two_person_team": { "type": "boolean" },
        "requires_public_official_companion": { "type": "boolean" }
      }
    },
    "visit_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "decided_by", "decided_at", "note"],
      "properties": {
        "decision": { "enum": ["approved", "rejected"] },
        "decided_by": { "type": "string", "minLength": 1, "maxLength": 100 },
        "decided_at": { "type": "string", "format": "date-time" },
        "note": { "type": "string", "maxLength": 500 }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "follow_up_deadline",
        "follow_up_status",
        "visit_approval_status",
        "transfer_status",
        "visit_decision"
      ],
      "properties": {
        "follow_up_deadline": { "$ref": "#/$defs/nullable_date" },
        "follow_up_status": { "enum": ["none", "required", "overdue", "completed"] },
        "visit_approval_status": {
          "enum": [null, "recommended", "approved", "rejected"]
        },
        "transfer_status": {
          "enum": ["not_required", "recommended", "requested", "transferred", "closed"]
        },
        "visit_decision": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/visit_decision" }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "follow_up_status": { "enum": ["required", "overdue"] }
            },
            "required": ["follow_up_status"]
          },
          "then": {
            "properties": {
              "follow_up_deadline": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              }
            }
          }
        }
      ]
    },
    "approved_visit_constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_route_distance_km",
        "assigned_worker_ids",
        "routing_interpretation"
      ],
      "properties": {
        "max_route_distance_km": { "type": "number", "exclusiveMinimum": 0 },
        "assigned_worker_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^SYN-W-\\d{10}-01$" }
        },
        "routing_interpretation": {
          "const": "approved_visit_only_not_person_risk"
        }
      }
    },
    "household": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "synthetic",
        "management_entry",
        "location",
        "contact",
        "visit_context",
        "workflow",
        "approved_visit_constraints"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^SYN-HH-\\d{10}-\\d{4}$" },
        "synthetic": { "const": true },
        "management_entry": { "$ref": "#/$defs/management_entry" },
        "location": { "$ref": "#/$defs/location" },
        "contact": { "$ref": "#/$defs/contact" },
        "visit_context": { "$ref": "#/$defs/visit_context" },
        "workflow": { "$ref": "#/$defs/workflow" },
        "approved_visit_constraints": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/approved_visit_constraints" }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "workflow": {
                "type": "object",
                "properties": { "visit_approval_status": { "const": "approved" } },
                "required": ["visit_approval_status"]
              }
            }
          },
          "then": {
            "properties": {
              "workflow": {
                "type": "object",
                "properties": {
                  "visit_decision": {
                    "type": "object",
                    "properties": { "decision": { "const": "approved" } },
                    "required": ["decision"]
                  }
                }
              },
              "approved_visit_constraints": { "$ref": "#/$defs/approved_visit_constraints" }
            }
          }
        },
        {
          "if": {
            "properties": {
              "workflow": {
                "type": "object",
                "properties": { "visit_approval_status": { "const": "rejected" } },
                "required": ["visit_approval_status"]
              }
            }
          },
          "then": {
            "properties": {
              "workflow": {
                "type": "object",
                "properties": {
                  "visit_decision": {
                    "type": "object",
                    "properties": { "decision": { "const": "rejected" } },
                    "required": ["decision"]
                  }
                }
              },
              "approved_visit_constraints": { "type": "null" }
            }
          }
        },
        {
          "if": {
            "properties": {
              "workflow": {
                "type": "object",
                "properties": {
                  "visit_approval_status": { "enum": [null, "recommended"] }
                },
                "required": ["visit_approval_status"]
              }
            }
          },
          "then": {
            "properties": {
              "workflow": {
                "type": "object",
                "properties": { "visit_decision": { "type": "null" } }
              },
              "approved_visit_constraints": { "type": "null" }
            }
          }
        }
      ]
    }
  }
}
