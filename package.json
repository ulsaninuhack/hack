{
  "name": "incheon-care-context-map",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "agent:check": "sh scripts/agent-check.sh",
    "check:ui-copy": "node --test test/ui-copy-gate.test.mjs && node scripts/check-ui-copy.mjs",
    "verify:overnight-freeze": "node scripts/verify-overnight-freeze.mjs",
    "verify:overnight": "npm run verify:overnight-freeze && npm run check:ui-copy && node scripts/verify-overnight-ui.mjs",
    "test:ui": "vitest run",
    "test:ui:watch": "vitest",
    "test:e2e:p2": "playwright test e2e/p2-contact-ops.spec.ts",
    "test:e2e:p4": "playwright test e2e/p4-contact-ops-golden.spec.ts",
    "test:e2e:p8": "playwright test e2e/p8-demo-hardening.spec.ts",
    "test:e2e:p9": "playwright test e2e/p9-three-tier.spec.ts",
    "test:e2e:ops": "playwright test e2e/p2-contact-ops.spec.ts e2e/p4-contact-ops-golden.spec.ts e2e/p8-demo-hardening.spec.ts e2e/p9-three-tier.spec.ts",
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/verify-map-worker.mjs",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "prepare:data": "python3 scripts/prepare_web_data.py --source-dir data/processed --output-dir public/data",
    "validate:data": "python3 scripts/prepare_web_data.py --source-dir data/processed --output-dir public/data --check",
    "test:facility-data": "python3 -m unittest scripts.test_prepare_web_data_facilities",
    "prepare:synthetic-data": "python3 scripts/generate_synthetic_care_ops.py",
    "validate:synthetic-schema": "node scripts/validate_synthetic_schemas.mjs",
    "validate:synthetic-data": "python3 scripts/generate_synthetic_care_ops.py --check && npm run validate:synthetic-schema",
    "test:synthetic-data": "python3 -m unittest scripts.test_generate_synthetic_care_ops",
    "test:contact-triage-schema": "node --test scripts/test_contact_triage_schemas.mjs",
    "test:macmini-llm-bridge": "npm --prefix macmini-llm-bridge test",
    "test:agent-handoff": "node --test test/agent-handoff-harness.test.mjs"
  },
  "dependencies": {
    "lucide-react": "1.31.0",
    "maplibre-gl": "6.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/geojson": "7946.0.16",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "axe-core": "4.11.0",
    "jsdom": "27.4.0",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
